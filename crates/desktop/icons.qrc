<!--
  The Editor tool rail's own icons.

  They live beside the QML module so the rail looks the same on every desktop:
  Breeze ships `transform-crop-symbolic` and friends, Adwaita and Papirus do
  not, and the rail is icon-only — a missing icon would be an empty button.
  The prefix is where the QML module registers `EditorView.qml` itself — the
  module keeps its `qml/` directory in the alias, so the file is at
  `qrc:/qt/qml/io/github/tienv2i/KogaView/qml/EditorView.qml`. A relative
  `source: "icons/crop.svg"` therefore has to land in `.../KogaView/qml/icons/`
  here, which is also the path the QML suites read as a real file.

  Each SVG is a plain two-tone drawing; `AbstractButton.icon.color` tints it
  with the theme colour, which is why the artwork is drawn in one dark colour
  rather than with its own palette.
-->
<RCC>
  <qresource prefix="/qt/qml/io/github/tienv2i/KogaView/qml">
    <file alias="icons/pointer.svg">qml/icons/pointer.svg</file>
    <file alias="icons/hand.svg">qml/icons/hand.svg</file>
    <file alias="icons/canvas-size.svg">qml/icons/canvas-size.svg</file>
    <file alias="icons/rotate-angle.svg">qml/icons/rotate-angle.svg</file>
    <file alias="icons/adjust.svg">qml/icons/adjust.svg</file>
    <file alias="icons/crop.svg">qml/icons/crop.svg</file>
    <file alias="icons/transform.svg">qml/icons/transform.svg</file>
    <file alias="icons/transform-free.svg">qml/icons/transform-free.svg</file>
    <file alias="icons/transform-scale.svg">qml/icons/transform-scale.svg</file>
    <file alias="icons/brush.svg">qml/icons/brush.svg</file>
    <file alias="icons/eyedropper.svg">qml/icons/eyedropper.svg</file>
    <file alias="icons/select.svg">qml/icons/select.svg</file>
    <file alias="icons/eraser.svg">qml/icons/eraser.svg</file>
    <file alias="icons/resize.svg">qml/icons/resize.svg</file>
    <file alias="icons/rotate-left.svg">qml/icons/rotate-left.svg</file>
    <file alias="icons/rotate-right.svg">qml/icons/rotate-right.svg</file>
    <file alias="icons/flip-horizontal.svg">qml/icons/flip-horizontal.svg</file>
    <file alias="icons/flip-vertical.svg">qml/icons/flip-vertical.svg</file>
    <file alias="icons/columns-two.svg">qml/icons/columns-two.svg</file>
    <file alias="icons/columns-one.svg">qml/icons/columns-one.svg</file>
    <file alias="icons/preferences.svg">qml/icons/preferences.svg</file>
    <file alias="icons/browser.svg">qml/icons/browser.svg</file>
    <file alias="icons/viewer.svg">qml/icons/viewer.svg</file>
    <file alias="icons/editor.svg">qml/icons/editor.svg</file>
    <file alias="icons/info.svg">qml/icons/info.svg</file>
    <file alias="icons/history.svg">qml/icons/history.svg</file>
    <file alias="icons/preview.svg">qml/icons/preview.svg</file>
    <file alias="icons/original.svg">qml/icons/original.svg</file>
    <file alias="icons/batch.svg">qml/icons/batch.svg</file>
    <file alias="icons/view-thumbnails.svg">qml/icons/view-thumbnails.svg</file>
    <file alias="icons/view-icons.svg">qml/icons/view-icons.svg</file>
    <file alias="icons/view-details.svg">qml/icons/view-details.svg</file>
    <file alias="icons/chevron.svg">qml/icons/chevron.svg</file>
    <file alias="icons/quick-access.svg">qml/icons/quick-access.svg</file>
    <file alias="icons/explorer.svg">qml/icons/explorer.svg</file>
    <file alias="icons/panel-hide-left.svg">qml/icons/panel-hide-left.svg</file>
    <file alias="icons/panel-hide-right.svg">qml/icons/panel-hide-right.svg</file>
    <file alias="icons/sidebar-left.svg">qml/icons/sidebar-left.svg</file>
    <file alias="icons/viewer-mode.svg">qml/icons/viewer-mode.svg</file>
    <file alias="icons/fullscreen.svg">qml/icons/fullscreen.svg</file>
    <file alias="icons/fullscreen-exit.svg">qml/icons/fullscreen-exit.svg</file>
    <file alias="icons/ai-rembg.svg">qml/icons/ai-rembg.svg</file>
  </qresource>
</RCC>
