[Desktop Entry]
Type=Application
Name=KogaView
GenericName=Image Viewer
Comment=Browse, view and edit photos
# `open %F` is the multi-file form: the launcher may hand over several paths
# (`%F`), and the executable's `open` mode takes every one of them.
Exec=@BINDIR@/kogaview open %F
TryExec=@BINDIR@/kogaview
Icon=io.github.tienv2i.KogaView
Terminal=false
# Graphics/Viewer is the "image viewer" group in both GNOME's and KDE's menus;
# Photography adds it to the photo applications list.
Categories=Graphics;Viewer;Photography;
Keywords=photo;image;picture;viewer;editor;browse;
# Only the codecs the build actually decodes (ADR 0005). `.heic`/`.heif` are
# listed by the browser but have no decoder, so they are deliberately absent:
# declaring them here would offer KogaView for a file it cannot open.
MimeType=image/jpeg;image/png;image/webp;image/gif;image/tiff;image/bmp;image/avif;image/vnd.ms-dds;image/x-exr;image/vnd.radiance;image/x-hdr;image/vnd.microsoft.icon;image/x-portable-anymap;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/qoi;image/x-tga;image/x-farbfeld;
# The X11 class name, so a window started from the launcher is grouped with the
# entry instead of appearing as a second, unnamed app. Verified with
# `xprop WM_CLASS` on a real window: ("kogaview", "KogaView").
StartupWMClass=KogaView
StartupNotify=true
