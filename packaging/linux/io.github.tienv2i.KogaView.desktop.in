[Desktop Entry]
Type=Application
Name=KogaView
Comment=Browse, view and edit photos
Exec=kogaview open %F
TryExec=kogaview
Icon=io.github.tienv2i.KogaView
Terminal=false
Categories=Graphics;Viewer;Photography;
MimeType=image/jpeg;image/png;image/webp;image/gif;image/tiff;image/bmp;
StartupNotify=true
