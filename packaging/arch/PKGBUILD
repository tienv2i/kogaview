# Maintainer: KogaView Contributors
pkgname=kogaview
pkgver=2.0.0
pkgrel=1
pkgdesc="Fast native desktop photo manager, viewer, and non-destructive editor"
arch=('x86_64')
url="https://github.com/tienv2i/kogaview"
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-5compat')
makedepends=('cmake' 'rust' 'cargo' 'qt6-tools' 'python')
source=()

build() {
  local src="${KOGAVIEW_SRC:-$startdir/../..}"
  if [ -n "${KOGAVIEW_PREBUILT:-}" ] && [ -x "$KOGAVIEW_PREBUILT" ]; then
    return 0
  fi
  cmake -S "$src" -B "$srcdir/build" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/build" --target kogaview kogaview_translations -j"$(nproc)"
}

package() {
  local src="${KOGAVIEW_SRC:-$startdir/../..}"
  local bin="${KOGAVIEW_PREBUILT:-$srcdir/build/bin/kogaview}"
  install -Dm755 "$bin" "$pkgdir/usr/bin/kogaview"
  install -Dm644 "$src/packaging/linux/io.github.tienv2i.KogaView.metainfo.xml" \
    "$pkgdir/usr/share/metainfo/io.github.tienv2i.KogaView.metainfo.xml"
  install -Dm644 "$src/packaging/linux/io.github.tienv2i.KogaView.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.tienv2i.KogaView.svg"
  install -Dm644 "$src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  python3 -c "
import pathlib
tpl = pathlib.Path('$src/packaging/linux/io.github.tienv2i.KogaView.desktop.in').read_text()
out = tpl.replace('@EXEC@', '/usr/bin/kogaview').replace('@ICON@', 'io.github.tienv2i.KogaView').replace('@NAME@', 'KogaView').replace('@MIME_TYPES@', 'image/png;image/jpeg;image/webp;image/gif;image/bmp;image/tiff;image/avif;image/x-tga;image/qoi;')
pathlib.Path('$pkgdir/usr/share/applications').mkdir(parents=True, exist_ok=True)
pathlib.Path('$pkgdir/usr/share/applications/io.github.tienv2i.KogaView.desktop').write_text(out)
"
}
