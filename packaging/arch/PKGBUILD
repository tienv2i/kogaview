# Maintainer: KogaView Contributors
pkgname=kogaview
pkgver=2.1.0
pkgrel=1
pkgdesc="Fast native desktop photo manager, viewer, and non-destructive editor"
arch=('x86_64')
url="https://github.com/tienv2i/kogaview"
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-5compat' 'dav1d')
makedepends=('cmake' 'ninja' 'pkgconf' 'rust' 'cargo' 'qt6-tools' 'python')
options=('!lto')
source=()

build() {
  local src="${KOGAVIEW_SRC:-$startdir/../..}"
  if [ -n "${KOGAVIEW_PREBUILT:-}" ] && [ -x "$KOGAVIEW_PREBUILT" ]; then
    return 0
  fi
  cmake -S "$src" -B "$srcdir/build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DKOGAVIEW_BUILD_TESTS=OFF \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/build" --target kogaview kogaview_translations -j"$(nproc)"
}

package() {
  local src="${KOGAVIEW_SRC:-$startdir/../..}"
  local bin="${KOGAVIEW_PREBUILT:-$srcdir/build/bin/kogaview}"
  install -Dm755 "$bin" "$pkgdir/usr/bin/kogaview"
  install -Dm644 "$src/packaging/linux/io.github.tienv2i.KogaView.metainfo.xml" \
    "$pkgdir/usr/share/metainfo/io.github.tienv2i.KogaView.metainfo.xml"
  install -Dm644 "$src/packaging/linux/io.github.tienv2i.KogaView.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.tienv2i.KogaView.svg"
  install -Dm644 "$src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  python3 -c "
import pathlib
apps = pathlib.Path('$pkgdir/usr/share/applications')
apps.mkdir(parents=True, exist_ok=True)
for name in ('io.github.tienv2i.KogaView.desktop', 'io.github.tienv2i.KogaView.Editor.desktop'):
    tpl = pathlib.Path('$src/packaging/linux/' + name + '.in').read_text()
    (apps / name).write_text(tpl.replace('@BINDIR@', '/usr/bin'))
"
}
